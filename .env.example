# .env.example
# Server Configuration
PORT=3000
CONFIG_DIR=./data

# Security
# Sets the password for the admin account (username: admin)
# On first run, an admin user is auto-created with this password
ADMIN_API_KEY=
# Set this to a strong secret to encrypt stored API keys and tokens in the config
# If not set, it defaults to ADMIN_API_KEY for backwards compatibility
ENCRYPTION_SECRET=

# Local Provider Configuration
LOCAL_URL=http://localhost:11434
LOCAL_KEY=

# Cloud Provider Configuration (OpenAI Compatible)
CLOUD_URL=
CLOUD_API_KEY=

# Intent Router Configuration
# The model used to classify prompt intent and route to the right category
ROUTER_MODEL=
# Optional: Custom URL for the router (defaults to Local Provider URL if blank)
ROUTER_URL=
# Optional: Custom API key for the router endpoint
ROUTER_KEY=
# Optional: Starting routing engine for new users: llm (router model) or jev (TypeSafe Jev, cloud)
ROUTER_ENGINE=llm
# Optional: TypeSafe API key for the Jev router (used when a user has not saved their own key)
TYPESAFE_API_KEY=

# LOCAL_*, CLOUD_*, ROUTER_MODEL/URL/KEY and ROUTER_ENGINE only seed the config of a user
# who has no saved settings yet. After a user saves settings in the UI, the saved values are used.

# Optional: Per-attempt chat timeout in milliseconds (default 300000 = 5 minutes)
CHAT_TIMEOUT_MS=
# Optional: Log level: trace, debug, info, warn, error
LOG_LEVEL=info
